<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Width="1020" Height="700" FontFamily="Microsoft YaHei UI, Segoe UI">
  <UserControl.Resources>
    <!-- ============ 配色 ============ -->
    <SolidColorBrush x:Key="BgDeep"      Color="#0A0D13"/>
    <SolidColorBrush x:Key="BgPanel"     Color="#11151D"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161B25"/>
    <SolidColorBrush x:Key="BgCardHi"    Color="#1C2331"/>
    <SolidColorBrush x:Key="Stroke"      Color="#232A38"/>
    <SolidColorBrush x:Key="StrokeHi"    Color="#2E3749"/>
    <SolidColorBrush x:Key="TextHi"      Color="#E8EDF5"/>
    <SolidColorBrush x:Key="TextMid"     Color="#9AA6B8"/>
    <SolidColorBrush x:Key="TextLow"     Color="#5E6B80"/>
    <SolidColorBrush x:Key="Accent"      Color="#22D3EE"/>
    <SolidColorBrush x:Key="AccentDim"   Color="#0E7490"/>
    <SolidColorBrush x:Key="Ok"          Color="#34D399"/>
    <SolidColorBrush x:Key="Warn"        Color="#FBBF24"/>
    <SolidColorBrush x:Key="Danger"      Color="#F43F5E"/>
    <SolidColorBrush x:Key="Violet"      Color="#818CF8"/>

    <!-- ============ 文字样式 ============ -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextLow}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextMid}"/>
    </Style>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- ============ 主按钮 ============ -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="#04141A"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#67E8F9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#0E7490"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Background" Value="#243040"/>
                <Setter Property="Foreground" Value="#55647A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="9" Background="#1A2130"
                    BorderBrush="{StaticResource StrokeHi}" BorderThickness="1" Padding="14,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#232C3D"/>
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#161B25"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 侧栏导航项 ============ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="9" Background="Transparent" Margin="0,2">
              <Grid>
                <Border x:Name="Bar" Width="3" CornerRadius="2" Background="{StaticResource Accent}"
                        HorizontalAlignment="Left" Margin="0,9,0,9" Visibility="Collapsed"/>
                <ContentPresenter Margin="18,0,10,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1A2130"/>
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="#18222E"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 自定义滑块 ============ -->
    <Style x:Key="ThinSlider" TargetType="Slider">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="8" CornerRadius="4" Background="#1E2635" VerticalAlignment="Center"/>
              <Border x:Name="Fill" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                      Background="{StaticResource Accent}" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb x:Name="Th" Width="22" Height="22" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Fill="#22D3EE" Opacity="0.20"/>
                          <Ellipse Width="16" Height="16" Fill="#E8EDF5" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Fill" Property="Background" Value="#2A3444"/>
                <Setter TargetName="Th" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 日志 ============ -->
    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="Background" Value="#0C1016"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="9" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- ================================================================ -->
  <Grid Background="{StaticResource BgDeep}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ==================== 左侧栏 ==================== -->
    <Border Grid.Column="0" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,26">
          <Border Width="34" Height="34" CornerRadius="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0"/>
                <GradientStop Color="#818CF8" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="T" FontSize="19" FontWeight="Bold" Foreground="#07131A"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TDPilot" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <TextBlock x:Name="TxtVer" Text="v1.0" FontSize="10" Foreground="{StaticResource TextLow}" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- 导航 -->
        <StackPanel Grid.Row="1">
          <TextBlock x:Name="TxtNavHead" Text="控制" FontSize="10" FontWeight="SemiBold"
                     Foreground="{StaticResource TextLow}" Margin="18,0,0,8"/>
          <RadioButton x:Name="NavDash" GroupName="nav" Style="{StaticResource NavItem}"
                       IsChecked="True" Content="仪表盘"/>
          <RadioButton x:Name="NavProf" GroupName="nav" Style="{StaticResource NavItem}" Content="预设方案"/>
          <RadioButton x:Name="NavAuto" GroupName="nav" Style="{StaticResource NavItem}" Content="自动化"/>
          <TextBlock x:Name="TxtNavSys" Text="系统" FontSize="10" FontWeight="SemiBold"
                     Foreground="{StaticResource TextLow}" Margin="18,20,0,8"/>
          <RadioButton x:Name="NavInfo" GroupName="nav" Style="{StaticResource NavItem}" Content="硬件信息"/>
          <RadioButton x:Name="NavSet"  GroupName="nav" Style="{StaticResource NavItem}" Content="设置"/>
          <RadioButton x:Name="NavAbout" GroupName="nav" Style="{StaticResource NavItem}" Content="关于"/>
        </StackPanel>

        <!-- 底部状态 -->
        <Border Grid.Row="3" CornerRadius="10" Background="#0E131B" Padding="12,10"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="DotDriver" Width="8" Height="8" Fill="{StaticResource TextLow}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtDriverState" Text="检测中…" FontSize="10.5" Margin="7,0,0,0"
                         Foreground="{StaticResource TextMid}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="TxtCpuShort" Text="—" FontSize="10" Margin="0,6,0,0"
                       Foreground="{StaticResource TextLow}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 右侧内容 ==================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 顶栏 -->
      <Border Grid.Row="0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="26,16,22,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtPageTitle" Text="仪表盘" Style="{StaticResource H1}"/>
            <TextBlock x:Name="TxtPageSub" Text="实时功耗与温度监控" FontSize="11.5"
                       Foreground="{StaticResource TextLow}" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnLang" Style="{StaticResource BtnGhost}" Width="62" Content="EN" Margin="0,0,8,0"/>
            <Button x:Name="BtnRefresh" Style="{StaticResource BtnGhost}" Width="86" Content="刷新"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面容器 -->
      <Grid Grid.Row="1" Margin="26,20,26,20">

        <!-- ========== 仪表盘页 ========== -->
        <Grid x:Name="PageDash">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="316"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 顶部三张读数卡 -->
          <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock x:Name="LblPower" Text="封装功耗" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <TextBlock x:Name="ValPower" Text="—" FontSize="30" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}"/>
                  <TextBlock Text="W" FontSize="14" Foreground="{StaticResource TextLow}"
                             VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                </StackPanel>
                <Border Height="4" CornerRadius="2" Background="#1E2635" Margin="0,12,0,0">
                  <Border x:Name="BarPower" Height="4" CornerRadius="2" Background="{StaticResource Accent}"
                          HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="SubPower" Text="限制 — / 峰值 —" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock x:Name="LblTemp" Text="核心温度" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <TextBlock x:Name="ValTemp" Text="—" FontSize="30" FontWeight="SemiBold"
                             Foreground="{StaticResource Warn}"/>
                  <TextBlock Text="°C" FontSize="14" Foreground="{StaticResource TextLow}"
                             VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                </StackPanel>
                <Border Height="4" CornerRadius="2" Background="#1E2635" Margin="0,12,0,0">
                  <Border x:Name="BarTemp" Height="4" CornerRadius="2" Background="{StaticResource Warn}"
                          HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="SubTemp" Text="温度墙 —" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
              <StackPanel>
                <TextBlock x:Name="LblFreq" Text="当前频率" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <TextBlock x:Name="ValFreq" Text="—" FontSize="30" FontWeight="SemiBold"
                             Foreground="{StaticResource Violet}"/>
                  <TextBlock Text="MHz" FontSize="13" Foreground="{StaticResource TextLow}"
                             VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                </StackPanel>
                <Border Height="4" CornerRadius="2" Background="#1E2635" Margin="0,12,0,0">
                  <Border x:Name="BarFreq" Height="4" CornerRadius="2" Background="{StaticResource Violet}"
                          HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="SubFreq" Text="—" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- 曲线卡 -->
          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="16,14,16,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <TextBlock x:Name="LblChart" Text="功耗 / 温度趋势" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                  <TextBlock Text="功耗 W" FontSize="10" Foreground="{StaticResource TextLow}" Margin="5,0,14,0"/>
                  <Ellipse Width="7" Height="7" Fill="{StaticResource Warn}" VerticalAlignment="Center"/>
                  <TextBlock Text="温度 °C" FontSize="10" Foreground="{StaticResource TextLow}" Margin="5,0,0,0"/>
                </StackPanel>
              </Grid>
              <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,10,0,0" ClipToBounds="True"/>
              <TextBlock Grid.Row="2" x:Name="TxtChartEmpty" Text="采集数据中…" FontSize="10.5"
                         Foreground="{StaticResource TextLow}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
          </Border>

          <!-- 右侧：功耗调节 -->
          <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="18,16,18,16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" x:Name="LblSetPower" Text="功耗上限" Style="{StaticResource H2}"/>

              <!-- 大数字 -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,2">
                <TextBlock x:Name="ValSetW" Text="25" FontSize="46" FontWeight="Bold"
                           Foreground="{StaticResource TextHi}"/>
                <TextBlock Text="W" FontSize="20" Foreground="{StaticResource TextLow}"
                           VerticalAlignment="Bottom" Margin="5,0,0,9"/>
              </StackPanel>
              <TextBlock Grid.Row="2" x:Name="TxtSetHint" Text="拖动滑块或点选预设，然后点「应用」"
                         FontSize="11" Foreground="{StaticResource TextLow}" Margin="0,0,0,14"/>

              <!-- 滑块 -->
              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Slider x:Name="SldPower" Grid.Row="0" Style="{StaticResource ThinSlider}"
                        Minimum="5" Maximum="54" Value="25" TickFrequency="1" IsSnapToTickEnabled="False"/>
                <Grid Grid.Row="1" Margin="2,2,2,0">
                  <TextBlock Text="5W" FontSize="9.5" Foreground="{StaticResource TextLow}" HorizontalAlignment="Left"/>
                  <TextBlock Text="30W" FontSize="9.5" Foreground="{StaticResource TextLow}" HorizontalAlignment="Center"/>
                  <TextBlock Text="54W" FontSize="9.5" Foreground="{StaticResource TextLow}" HorizontalAlignment="Right"/>
                </Grid>
              </Grid>

              <!-- 预设 -->
              <StackPanel Grid.Row="4" Margin="0,16,0,0">
                <TextBlock x:Name="LblPresets" Text="快速预设" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextLow}" Margin="0,0,0,9"/>
                <UniformGrid Columns="3" Rows="2">
                  <Button x:Name="Pr15" Style="{StaticResource BtnGhost}" Content="15W 省电" Margin="0,0,5,5" Height="36"/>
                  <Button x:Name="Pr25" Style="{StaticResource BtnGhost}" Content="25W 均衡" Margin="0,0,5,5" Height="36"/>
                  <Button x:Name="Pr30" Style="{StaticResource BtnGhost}" Content="30W 性能" Margin="0,0,0,5" Height="36"/>
                  <Button x:Name="Pr45" Style="{StaticResource BtnGhost}" Content="45W 满血" Margin="0,0,5,0" Height="36"/>
                  <Button x:Name="PrMax" Style="{StaticResource BtnGhost}" Content="恢复默认" Margin="0,0,5,0" Height="36"/>
                  <Button x:Name="PrCustom" Style="{StaticResource BtnGhost}" Content="自定义…" Margin="0,0,0,0" Height="36"/>
                </UniformGrid>
              </StackPanel>

              <!-- 应用按钮 -->
              <StackPanel Grid.Row="5" Margin="0,16,0,0">
                <Button x:Name="BtnApply" Style="{StaticResource BtnPrimary}" Content="应用功耗上限"/>
                <TextBlock x:Name="TxtApplyState" Text=" " FontSize="10.5" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextLow}" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 底部日志 -->
          <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}" Padding="14,12,14,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="LblLog" Text="运行日志" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="TxtLogCount" Text="" FontSize="10" Foreground="{StaticResource TextLow}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="BtnClearLog" Style="{StaticResource BtnGhost}" Content="清空" Height="26" FontSize="11"/>
                </StackPanel>
              </Grid>
              <TextBox x:Name="TxtLog" Grid.Row="1" Style="{StaticResource LogBox}" Height="86"/>
            </Grid>
          </Border>
        </Grid>

        <!-- ========== 预设方案页 ========== -->
        <Grid x:Name="PageProf" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
              <StackPanel>
                <TextBlock x:Name="TxtProfHead" Text="我的预设" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TxtProfDesc" Text="把常用的功耗配置存下来，一键切换"
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="BtnProfNew" Style="{StaticResource BtnGhost}" Content="新建预设"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Width="98"/>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ProfList"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ========== 自动化页 ========== -->
        <Grid x:Name="PageAuto" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="TxtAutoHead" Text="开机与唤醒自动套用" Style="{StaticResource H2}"/>
              <TextBlock x:Name="TxtAutoDesc" Text="登录时自动把你的功耗上限写回处理器，不需要管理员账号，也不需要常驻后台。"
                         Style="{StaticResource Body}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="BtnAutoInstall" Style="{StaticResource BtnPrimary}" Content="启用自动套用" Width="150" Height="38"/>
                <Button x:Name="BtnAutoRemove" Style="{StaticResource BtnGhost}" Content="移除" Width="88" Margin="10,0,0,0"/>
                <Button x:Name="BtnAutoRunNow" Style="{StaticResource BtnGhost}" Content="立即套用一次" Width="118" Margin="10,0,0,0"/>
                <Border x:Name="BadgeAuto" CornerRadius="8" Background="#1A2130" Padding="10,5"
                        Margin="14,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotAuto" Width="7" Height="7" Fill="{StaticResource TextLow}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAutoState" Text="未启用" FontSize="11" Margin="7,0,0,0"
                               Foreground="{StaticResource TextMid}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="TxtTrigHead" Text="触发器" Style="{StaticResource H2}"/>
              <StackPanel x:Name="TrigList" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="TxtTaskHead" Text="任务详情" Style="{StaticResource H2}"/>
              <TextBlock x:Name="TxtTaskBody" Text="—" Style="{StaticResource Caption}" Margin="0,10,0,0"
                         TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ========== 硬件信息页 ========== -->
        <Grid x:Name="PageHw" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="TxtHwCpuHead" Text="处理器" Style="{StaticResource H2}"/>
              <StackPanel x:Name="HwCpuList" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="TxtHwLimitHead" Text="当前限制" Style="{StaticResource H2}"/>
              <StackPanel x:Name="HwLimitList" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ========== 设置页 ========== -->
        <Grid x:Name="PageSet" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <TextBlock x:Name="TxtSetHead" Text="常规" Style="{StaticResource H2}"/>

              <Grid Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock x:Name="LblSetRefresh" Text="刷新间隔" FontSize="12.5" Foreground="{StaticResource TextHi}"/>
                  <TextBlock x:Name="TxtSetRefreshDesc" Text="读取功耗数据的频率；读取一次约需 1 秒"
                             Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Slider x:Name="SldRefresh" Width="160" Minimum="2" Maximum="15" Value="3"
                          TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ThinSlider}"/>
                  <TextBlock x:Name="TxtRefreshVal" Text="3 s" FontSize="12" Foreground="{StaticResource Accent}"
                             VerticalAlignment="Center" Width="46" TextAlignment="Right"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Stroke}" Margin="0,18"/>

              <Grid>
                <StackPanel>
                  <TextBlock x:Name="LblSetLang" Text="界面语言" FontSize="12.5" Foreground="{StaticResource TextHi}"/>
                  <TextBlock x:Name="TxtSetLangDesc" Text="立即生效" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnLangZh" Style="{StaticResource BtnGhost}" Content="简体中文" Width="86"/>
                  <Button x:Name="BtnLangEn" Style="{StaticResource BtnGhost}" Content="English" Width="80" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>

              <Border Height="1" Background="{StaticResource Stroke}" Margin="0,18"/>

              <Grid>
                <StackPanel>
                  <TextBlock x:Name="LblSetLog" Text="日志与数据" FontSize="12.5" Foreground="{StaticResource TextHi}"/>
                  <TextBlock x:Name="TxtSetLogDesc" Text="配置、日志保存在程序数据目录" Style="{StaticResource Caption}"
                             Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnOpenData" Style="{StaticResource BtnGhost}" Content="打开目录" Width="86"/>
                  <Button x:Name="BtnCopyDiag" Style="{StaticResource BtnGhost}" Content="复制诊断" Width="86" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ========== 关于页 ========== -->
        <Grid x:Name="PageAbout" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Padding="26,22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="46" Height="46" CornerRadius="13">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22D3EE" Offset="0"/>
                        <GradientStop Color="#818CF8" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="T" FontSize="25" FontWeight="Bold" Foreground="#07131A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAboutName" Text="TDPilot" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextHi}"/>
                    <TextBlock x:Name="TxtAboutVer" Text="版本 1.0.0" FontSize="11.5"
                               Foreground="{StaticResource TextLow}" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtAboutDesc" Text="面向 AMD Ryzen 处理器的功耗墙调节工具"
                           Style="{StaticResource Body}" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="20"/>
                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,18"/>
                <TextBlock x:Name="TxtAboutLicHead" Text="开源许可" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TxtAboutLic" Style="{StaticResource Body}" Margin="0,8,0,0"
                           TextWrapping="Wrap" LineHeight="20"/>
                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,18"/>
                <TextBlock x:Name="TxtAboutEnvHead" Text="运行环境" Style="{StaticResource H2}"/>
                <TextBlock x:Name="TxtAboutEnv" Style="{StaticResource Body}" Margin="0,8,0,0"
                           TextWrapping="Wrap" FontFamily="Consolas, monospace" LineHeight="19"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>